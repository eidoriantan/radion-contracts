                        PAIR 3 ;
                        CONS ;
                        DUP 3 ;
                        CAR ;
                        DIG 4 ;
                        GET 4 ;
                        DIG 4 ;
                        GET 4 ;
                        PAIR ;
                        CONS ;
                        PAIR 3 } ;
                 UNPAIR 3 ;
                 DIG 3 ;
                 SWAP ;
                 NIL (pair nat (map string bytes)) ;
                 SWAP ;
                 ITER { CONS } ;
                 ITER { DUP ;
                        CAR ;
                        DUP 3 ;
                        CAR ;
                        CDR ;
                        CDR ;
                        DUP 2 ;
                        GET ;
                        IF_NONE
                          { DUP 3 ;
                            CDR ;
