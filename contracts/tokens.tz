               { DIG 4 ;
                 DROP ;
                 DUP 2 ;
                 CAR ;
                 CDR ;
                 DUP ;
                 CAR ;
                 CAR ;
                 CDR ;
                 NIL (pair address nat nat) ;
                 NIL (pair nat (map string bytes)) ;
                 PAIR 3 ;
                 DIG 2 ;
                 ITER { SWAP ;
                        PUSH nat 1 ;
                        DUP 2 ;
                        GET 4 ;
                        ADD ;
                        DUP 2 ;
                        GET 3 ;
                        DUP 4 ;
                        GET 3 ;
                        DUP 4 ;
                        GET 4 ;
                        DUP 6 ;
